# ==============================================================================
# CodeLens Configuration
# ==============================================================================

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# ==============================================================================
# LLM & Embedding Providers (Gemini Cloud vs Local Offline)
# ==============================================================================
# Active provider: 'gemini' (default, powered by Google GenAI) or 'local' (offline Qwen)
LLM_PROVIDER=gemini

# Google Gemini API Settings (Read server-side only; NEVER exposed to frontend)
# Obtain your free key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Local LLM & Reasoning (100% Offline Mode fallback)
LLM_MODEL=Qwen/Qwen2.5-Coder-1.5B-Instruct
MAX_CONTEXT_TOKENS=2048
MAX_SOURCES=5
MAX_LLM_OUTPUT_TOKENS=1024

# Embedding Model Configuration (Local SentenceTransformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=auto

# ==============================================================================
# GitHub Integration & OAuth (Explore & Contribute Features)
# ==============================================================================
# GitHub Personal Access Token (PAT) for Explore & Contribute features
# Increases GitHub REST API rate limit from 60 req/hr to 5,000 req/hr
# Generate at: https://github.com/settings/tokens (public_repo scope sufficient)
GITHUB_TOKEN=your_github_token_here

# Optional GitHub OAuth Login (for student language personalization & bookmarks)
# Create OAuth app at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Seasonal Event Banner Slot (e.g. Hacktoberfest / Student Open-Source Sprint)
SEASONAL_BANNER_ENABLED=true
SEASONAL_BANNER_TEXT=🍂 Hacktoberfest & Student Contributor Sprint: Pick a beginner-friendly issue and analyze the architecture in CodeLens!
SEASONAL_BANNER_LINK=https://hacktoberfest.com

# ==============================================================================
# Rate Limiting & Safety
# ==============================================================================
RATE_LIMIT_PER_MINUTE=30

# Retrieval & Hybrid Search Settings
TOP_K=5
DEFAULT_HYBRID_ALPHA=0.6
BM25_K1=1.5
BM25_B=0.75

# Storage & Cache Paths
DATA_DIR=./data
VECTOR_INDEX_PATH=./data/indexes
BM25_INDEX_PATH=./data/indexes
ML_RANKER_PATH=./models/retrieval_ranker/v1
MAINTAINABILITY_MODEL_PATH=./models/maintainability/v1

# Ingestion & Resource Limits
MAX_REPO_SIZE_MB=200
MAX_FILE_SIZE_BYTES=524288
MAX_FILES_COUNT=5000
MAX_CHUNK_LINES=300
