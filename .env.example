# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Local LLM & Reasoning (100% Offline, No OpenAI/Paid API Keys)
LLM_MODEL=Qwen/Qwen2.5-Coder-1.5B-Instruct
MAX_CONTEXT_TOKENS=2048
MAX_SOURCES=5
MAX_LLM_OUTPUT_TOKENS=1024

# Embedding Model Configuration (Local Transformer)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=auto

# Retrieval & Hybrid Search Settings
TOP_K=5
DEFAULT_HYBRID_ALPHA=0.6
BM25_K1=1.5
BM25_B=0.75

# Storage & Model Artifact Paths
DATA_DIR=./data
VECTOR_INDEX_PATH=./data/indexes
BM25_INDEX_PATH=./data/indexes
ML_RANKER_PATH=./models/retrieval_ranker/v1
MAINTAINABILITY_MODEL_PATH=./models/maintainability/v1

# Ingestion & Resource Limits
MAX_REPO_SIZE_MB=200
MAX_FILE_SIZE_BYTES=524288
MAX_FILES_COUNT=5000
MAX_CHUNK_LINES=300
